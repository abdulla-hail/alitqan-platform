# ── Supabase (Project Settings → API) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The public "anon" / publishable key — safe in the browser, RLS protects data
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, used only by `npm run db:migrate` / `db:seed` (session pooler, port 5432)
DATABASE_URL=

# ── Site ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-time secret that unlocks /admin/setup to create the first owner account.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Remove it after the owner exists.
SETUP_TOKEN=

# Salt for hashing visitor IPs in the form rate limiter (any long random string)
IP_HASH_SALT=

# ── Email notifications (optional, https://resend.com) ─────────────
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "ALITQAN <notifications@alitqan.com>"
EMAIL_FROM=

# ── Bot protection (optional, Cloudflare Turnstile) ────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
